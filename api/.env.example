# Database
DB_URL=jdbc:postgresql://localhost:5432/hall_of_fame
DB_USERNAME=hof_user
DB_PASSWORD=hof_dev_password

# Server & CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev

# Auth (change JWT_SECRET and ADMIN_PASSWORD in production!)
JWT_SECRET=change-this-to-a-long-random-256-bit-secret-key-for-hall-of-fame
JWT_EXPIRY_SECONDS=3600
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-dev-password

# Storage
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
